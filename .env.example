# من Supabase: Project Settings > Database > Connection string > Transaction pooler (بورت 6543)
DATABASE_URL=postgresql://postgres.xxxx:كلمة_السر@aws-0-xx.pooler.supabase.com:6543/postgres
# أرقام استلام الفلوس (بتظهر للطالب في صفحة الشحن)
VODAFONE_CASH_NUMBER=01xxxxxxxxx
INSTAPAY_HANDLE=yourname@instapay
# للتشغيل المحلي فقط
PORT=3000
